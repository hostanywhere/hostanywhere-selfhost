# Dashboard + API at the apex; service subdomains proxy to the tunnels relay.
#
# TLS is fully automatic, no wildcard needed:
#   - apex + relay.<domain>: ordinary HTTP-01 certificates at startup
#   - *.<domain> service URLs: per-subdomain certificates issued on demand
#     the first time each URL is visited. The control plane's /api/tls-ask
#     endpoint approves only hostnames that belong to this deployment.

{
	on_demand_tls {
		ask http://control:4000/api/tls-ask
	}
}

{$DOMAIN} {
	# WG-over-WebSocket fallback for devices on UDP-blocked networks.
	handle /ha-relay {
		reverse_proxy control:51823
	}
	handle {
		reverse_proxy control:4000
	}
}

# Explicit block so Caddy obtains a dedicated certificate for the relay host
# at startup — the relay serves this same cert on its agent port (7443) via
# the shared caddy_data volume.
relay.{$DOMAIN} {
	reverse_proxy relay:8080
}

*.{$DOMAIN} {
	tls {
		on_demand
	}
	reverse_proxy relay:8080
}
