# HostAnywhere self-host — copy to .env and fill in.

# Your domain. DNS A records required: <domain>, *.<domain>, relay.<domain>
# all pointing at this host.
DOMAIN=hostanywhere.example.com

# Session-signing secret. Generate: openssl rand -hex 32
JWT_SECRET=

# Optional SMTP for sign-in emails. Leave empty to print magic links to the
# control container's log instead (docker compose logs -f control).
SMTP_HOST=
SMTP_PORT=587
# Set to "true" only for port-465 (implicit TLS) providers.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=

# Optional social sign-in: register your own OAuth app with each provider you
# want (callback URLs + walkthrough in README "Social sign-in") and fill these.
# The sign-in page shows each provider's button automatically when set.
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=
#GITHUB_CLIENT_ID=
#GITHUB_CLIENT_SECRET=
#MICROSOFT_CLIENT_ID=
#MICROSOFT_CLIENT_SECRET=
# Apple requires a paid developer account; most self-hosters skip it.
#APPLE_SERVICE_ID=
#APPLE_TEAM_ID=
#APPLE_KEY_ID=
#APPLE_PRIVATE_KEY=

# Image version to run (tag from ghcr.io/hostanywhere/hostanywhere-control).
# Default: latest
#HA_VERSION=
